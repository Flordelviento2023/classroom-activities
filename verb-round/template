<div class="wrap">

  <h1>Verb Round</h1>
  <p class="subtitle">Listen closely to the verb — which one, and in which form?</p>

  <div id="screen-start">
    <p>You'll hear 7 short chunks about the company Innocent. In fast, connected speech, verb endings like <em>-s</em>, <em>-ing</em> and <em>'s</em> are easy to miss.<br>
    Listen carefully and tap the exact verb form you hear. Try to beat your own time!</p>
    <button class="btn-primary" id="btn-start">Start</button>
  </div>

  <div id="screen-game">
    <div class="statbar">
      <div class="stat"><span class="label">Time</span><span class="value" id="timer">0.0s</span></div>
      <div class="stat"><span class="label">Round</span><span class="value" id="round-count">1 / 7</span></div>
    </div>
    <div class="listen-row">
      <button class="btn-primary" id="btn-play">🔊 Listen</button>
      <button class="btn-secondary" id="btn-replay">↺ Listen again</button>
    </div>
    <div id="feedback">&nbsp;</div>
    <div class="grid" id="options"></div>
  </div>

  <div id="screen-end">
    <p>Round complete!</p>
    <div class="big-time" id="final-time">0.0s</div>
    <p class="best-note" id="best-note"></p>
    <button class="btn-primary" id="btn-again">Play again</button>
  </div>

</div>

<script>
  var TARGET_VERBS = [
    {
      value: "are looking",
      sentence: "This month we are looking at the role of ethics in business.",
      distractors: ["look", "looked", "are watching", "were looking"]
    },
    {
      value: "operates",
      sentence: "Innocent now operates from its headquarters in London as a subsidiary of Coca-Cola.",
      distractors: ["is operating", "operated", "opens", "is opening"]
    },
    {
      value: "continues",
      sentence: "Innocent continues to innovate.",
      distractors: ["is continuing", "continued", "manages", "is managing"]
    },
    {
      value: "'s constantly working",
      sentence: "The company's constantly working on new lines.",
      distractors: ["constantly works", "constantly worked", "'s constantly looking", "is constantly planning"]
    },
    {
      value: "sells",
      sentence: "Innocent sells to over ten thousand retailers in thirteen European countries.",
      distractors: ["is selling", "sold", "supplies", "is supplying"]
    },
    {
      value: "is constantly growing",
      sentence: "...and its market is constantly growing.",
      distractors: ["constantly grows", "constantly grew", "is constantly expanding", "constantly expands"]
    },
    {
      value: "uses",
      sentence: "It uses only 100% natural products.",
      distractors: ["is using", "used", "makes", "is making"]
    }
  ];

  var rounds = [];
  var currentRound = 0;
  var startTime = 0;
  var timerInterval = null;
  var bestTime = null;

  function shuffle(arr){
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--){
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }

  function buildRounds(){
    rounds = shuffle(TARGET_VERBS);
  }

  function optionsForRound(item){
    var picks = shuffle(item.distractors).slice(0, 5);
    picks.push(item.value);
    return shuffle(picks);
  }

  function speak(text){
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    var utter = new SpeechSynthesisUtterance(text);
    utter.lang = 'en-GB';
    utter.rate = 0.9;
    window.speechSynthesis.speak(utter);
  }

  function formatTime(ms){
    return (ms / 1000).toFixed(1) + 's';
  }

  function updateTimerDisplay(){
    var el = document.getElementById('timer');
    el.textContent = formatTime(Date.now() - startTime);
  }

  function renderRound(){
    var round = rounds[currentRound];
    document.getElementById('round-count').textContent = (currentRound + 1) + ' / ' + rounds.length;
    document.getElementById('feedback').textContent = '\u00A0';
    document.getElementById('feedback').className = '';

    var optionsEl = document.getElementById('options');
    optionsEl.innerHTML = '';
    var opts = optionsForRound(round);
    opts.forEach(function(opt){
      var btn = document.createElement('button');
      btn.className = 'chip';
      btn.textContent = opt;
      btn.addEventListener('click', function(){ handleAnswer(opt, round.value, btn); });
      optionsEl.appendChild(btn);
    });

    speak(round.sentence);
  }

  function handleAnswer(selected, correct, btnEl){
    var fb = document.getElementById('feedback');
    if (selected === correct){
      btnEl.classList.add('correct');
      fb.textContent = 'Correct!';
      fb.className = 'ok';
      Array.prototype.forEach.call(document.querySelectorAll('.chip'), function(c){ c.disabled = true; });
      setTimeout(nextRound, 700);
    } else {
      btnEl.classList.add('wrong');
      btnEl.disabled = true;
      fb.textContent = 'Try again — listen for the exact ending.';
      fb.className = 'no';
    }
  }

  function nextRound(){
    currentRound++;
    if (currentRound >= rounds.length){
      finishGame();
    } else {
      renderRound();
    }
  }

  function startGame(){
    buildRounds();
    currentRound = 0;
    document.getElementById('screen-start').style.display = 'none';
    document.getElementById('screen-end').style.display = 'none';
    document.getElementById('screen-game').style.display = 'block';
    startTime = Date.now();
    timerInterval = setInterval(updateTimerDisplay, 100);
    renderRound();
  }

  function finishGame(){
    clearInterval(timerInterval);
    var elapsed = Date.now() - startTime;
    document.getElementById('screen-game').style.display = 'none';
    document.getElementById('screen-end').style.display = 'block';
    document.getElementById('final-time').textContent = formatTime(elapsed);

    var note = document.getElementById('best-note');
    if (bestTime === null || elapsed < bestTime){
      bestTime = elapsed;
      note.textContent = 'New best time this session!';
    } else {
      note.textContent = 'Your best time this session: ' + formatTime(bestTime);
    }
  }

  document.getElementById('btn-start').addEventListener('click', startGame);
  document.getElementById('btn-again').addEventListener('click', startGame);
  document.getElementById('btn-play').addEventListener('click', function(){
    speak(rounds[currentRound].sentence);
  });
  document.getElementById('btn-replay').addEventListener('click', function(){
    speak(rounds[currentRound].sentence);
  });
</script>
</body>
</html>
