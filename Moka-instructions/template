<div class="wrap">
  <h1>Talk to Moka 🤖</h1>
  <div class="subtitle">People & Training — Free Conversation</div>
  <div class="instruction-note">Copy the text below and paste it into Moka to start your conversation.</div>

  <div class="prompt-box">
    <span class="label">PASTE THIS INTO MOKA</span>
    You are a friendly coworker at LongHorn Steakhouse. I'm training to become a shift supervisor, and I want to practice talking about new hire training, onboarding, and Personal Development Plans. Ask me questions about how I track training, how onboarding works, and what happens with certification gaps, the way a curious coworker would. Push me to answer using passive voice sentences and phrasal verbs like "check in with," "followed up on," and "sit in on." I already speak English well, so don't make it too easy — if I answer in a simple way, gently push me to say it in a more professional, polished way instead. Keep the conversation natural, like a real conversation between coworkers, not a quiz.
  </div>

  <button class="copy-btn" id="copyBtn">📋 Copy Instructions</button>

  <div class="after-note">Once Moka responds, keep the conversation going for about 20-30 minutes — don't stop after one exchange.</div>
</div>

<script>
  document.getElementById('copyBtn').addEventListener('click', () => {
    const text = document.querySelector('.prompt-box').innerText.replace('PASTE THIS INTO MOKA', '').trim();
    const btn = document.getElementById('copyBtn');

    function showCopied() {
      btn.textContent = '✅ Copied!';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = '📋 Copy Instructions';
        btn.classList.remove('copied');
      }, 2000);
    }

    function fallbackCopy() {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      try {
        document.execCommand('copy');
        showCopied();
      } catch (err) {
        alert('No se pudo copiar automáticamente. Por favor selecciona el texto manualmente.');
      }
      document.body.removeChild(textarea);
    }

    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(showCopied).catch(fallbackCopy);
    } else {
      fallbackCopy();
    }
  });
</script>
