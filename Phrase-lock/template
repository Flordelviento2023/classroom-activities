<body>
<div class="wrap">
  <h1>Phrase Lock 🔒</h1>
  <div class="subtitle">Use the new phrase to unlock the next situation</div>

  <div class="progress-wrap" id="progressWrap"></div>

  <div class="game-card" id="gameCard">
    <div class="card-num" id="cardNum">Card 1 of 8</div>
    <div class="lock-icon">🔒</div>
    <div class="situation-label">SITUATION</div>
    <div class="situation-text" id="situationText"></div>

    <div class="required-hint" id="requiredHint"></div>

    <textarea id="answerInput" placeholder="Write your response..."></textarea>
    <div class="feedback" id="feedback"></div>
    <button class="submit-btn" id="submitBtn">Unlock ➜</button>
  </div>

  <div class="summary-card" id="summaryCard">
    <h2>🎉 All Unlocked!</h2>
    <div class="stat-row">
      <div class="stat">
        <div class="stat-num" id="firstTryCount">0</div>
        <div class="stat-label">First-try correct</div>
      </div>
      <div class="stat">
        <div class="stat-num" id="retryCount">0</div>
        <div class="stat-label">Needed a retry</div>
      </div>
    </div>
    <button class="restart-btn" id="restartBtn">Play Again</button>
  </div>
</div>

<script>
  // ============================================
  // DECK — swap this array to reuse for any session/topic
  // Each card: situation (the prompt), requiredPhrase (must appear
  // in the student's answer, case-insensitive), hint (shown after 1 wrong try)
  // ============================================
  const deck = [
    {
      situation: "A new hire just finished their first training shift. Tell them to complete their online onboarding tonight.",
      requiredPhrase: "i need you to",
      hint: 'Start with: "I need you to..."'
    },
    {
      situation: "Remind a team member that their Learning Tool module is due before Friday.",
      requiredPhrase: "make sure",
      hint: 'Use: "Can you make sure..."'
    },
    {
      situation: "Explain to a new server that they'll have a Personal Development Plan review with you next month.",
      requiredPhrase: "it's important that you",
      hint: 'Use: "It\'s important that you..."'
    },
    {
      situation: "Ask a coworker to walk you through how they completed the New Hire Training checklist.",
      requiredPhrase: "walk me through",
      hint: 'Use: "Can you walk me through..."'
    },
    {
      situation: "Tell a trainee once they finish stocking, you want them to report back to you.",
      requiredPhrase: "let me know",
      hint: 'Use: "...let me know once you\'re done."'
    },
    {
      situation: "You're interviewing a candidate for a server position. Ask about their availability professionally.",
      requiredPhrase: "i'd like to ask",
      hint: 'Use: "I\'d like to ask you about..."'
    },
    {
      situation: "A manager asks if the new hire is ready for the floor. Give a diplomatic, professional answer — not just \"yes\" or \"no.\"",
      requiredPhrase: "at this point",
      hint: 'Use: "At this point, I\'d say..."'
    },
    {
      situation: "Tell a team member you noticed they've been improving and you want to recognize that.",
      requiredPhrase: "i wanted to point out",
      hint: 'Use: "I wanted to point out that..."'
    }
  ];
  // ============================================

  let current = 0;
  let usedRetry = new Array(deck.length).fill(false);
  let attemptedOnce = false;

  const progressWrap = document.getElementById('progressWrap');
  const cardNum = document.getElementById('cardNum');
  const situationText = document.getElementById('situationText');
  const requiredHint = document.getElementById('requiredHint');
  const answerInput = document.getElementById('answerInput');
  const feedback = document.getElementById('feedback');
  const submitBtn = document.getElementById('submitBtn');
  const gameCard = document.getElementById('gameCard');
  const summaryCard = document.getElementById('summaryCard');

  function buildProgress(){
    progressWrap.innerHTML = '';
    deck.forEach((_, i) => {
      const seg = document.createElement('div');
      seg.className = 'progress-seg';
      if (i < current) seg.classList.add('done');
      if (i === current) seg.classList.add('current');
      progressWrap.appendChild(seg);
    });
  }

  function loadCard(){
    const card = deck[current];
    cardNum.textContent = `Card ${current + 1} of ${deck.length}`;
    situationText.textContent = card.situation;
    requiredHint.textContent = card.hint;
    requiredHint.classList.remove('show');
    answerInput.value = '';
    feedback.textContent = '';
    feedback.className = 'feedback';
    attemptedOnce = false;
    buildProgress();
  }

  function checkAnswer(){
    const card = deck[current];
    const val = answerInput.value.trim().toLowerCase();

    if (!val){
      feedback.textContent = 'Write a full response first.';
      feedback.className = 'feedback incorrect-text';
      return;
    }

    if (val.includes(card.requiredPhrase)){
      feedback.textContent = '🔓 Unlocked! Great use of the phrase.';
      feedback.className = 'feedback correct-text';
      submitBtn.disabled = true;
      setTimeout(() => {
        current++;
        submitBtn.disabled = false;
        if (current >= deck.length){
          showSummary();
        } else {
          loadCard();
        }
      }, 900);
    } else {
      usedRetry[current] = true;
      feedback.textContent = "Not quite — you're still using the phrase you already know. Try again with the new one.";
      feedback.className = 'feedback incorrect-text';
      if (attemptedOnce){
        requiredHint.classList.add('show');
      }
      attemptedOnce = true;
    }
  }

  function showSummary(){
    gameCard.style.display = 'none';
    progressWrap.style.display = 'none';
    summaryCard.style.display = 'block';
    const retries = usedRetry.filter(Boolean).length;
    document.getElementById('firstTryCount').textContent = deck.length - retries;
    document.getElementById('retryCount').textContent = retries;
  }

  submitBtn.addEventListener('click', checkAnswer);
  answerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey){
      e.preventDefault();
      checkAnswer();
    }
  });

  document.getElementById('restartBtn').addEventListener('click', () => {
    current = 0;
    usedRetry = new Array(deck.length).fill(false);
    gameCard.style.display = 'block';
    progressWrap.style.display = 'flex';
    summaryCard.style.display = 'none';
    loadCard();
  });

  loadCard();
</script>
</body>
</html>
